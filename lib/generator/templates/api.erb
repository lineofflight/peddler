# frozen_string_literal: true

# <%= Generator::Config::GENERATED_FILE_NOTICE %>

module Peddler
  module APIs
    <%= title %>
    #
    <%= description %>
    #
    # @see https://github.com/amzn/selling-partner-api-models/blob/main/models/<%= github_model_filename %>
    module <%= class_name %>
      # Typed models of successful responses, by native operation key. Shareable, so that any Ractor can read it.
<% if parsers.empty? -%>
      PARSERS = {}.freeze # steep:ignore UnannotatedEmptyCollection
<% else -%>
      PARSERS = Ractor.make_shareable({
<% parsers.each do |key, model| -%>
        "<%= key %>" => -> { <%= model %> },
<% end -%>
      })
<% end -%>
    end
  end
end
