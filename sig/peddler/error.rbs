module Peddler
  class Error < StandardError
    @response: Response?
    @code: String?
    @request_id: String?

    attr_reader response: Response?
    attr_reader code: String?
    attr_reader request_id: String?

    def initialize: (?String? message, ?Response? response, ?code: String?, ?request_id: String?) -> void
    def status: () -> Integer?
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
  end
end
