module Peddler
  module Native
    type error_metadata = [String?, String?, String?]
    type response_parts = [Integer, Array[[String, String]], String, error_metadata?]

    def self.engine: (String config) -> Engine
    def self.lwa_engine: (String client_id, String client_secret, Numeric timeout, String endpoint) -> LwaEngine
    def self.utf8_text?: (untyped value) -> bool
    def self.positive_seconds?: (untyped value) -> bool
    def self.generate: (untyped value) -> String?
    def self.user_agent: () -> String
    def self.status_reason: (Integer code) -> String?

    type tokens = [String, String?, String, Integer]

    # What the generated facades take
    type engine = Engine

    # Anything that returns the access token when called
    interface _TokenSource
      def call: () -> untyped
    end

    def self.access_token: (untyped value) -> String
    def self.token_source: (untyped value) -> _TokenSource?

    class Engine
      def self.from_config: (String config) -> Engine
      def with_base_url: (String base_url) -> Engine
      def with_access_token: (String access_token) -> Engine
      def with_token_source: (_TokenSource source) -> Engine
      def inspect: () -> String
      def request: (String method, String path, Array[[String, String]] query, String? body) -> response_parts
      def operation: (String operation, String arguments) -> response_parts
    end

    class LwaEngine
      def self.new: (String client_id, String client_secret, Numeric timeout, String endpoint) -> LwaEngine
      def exchange_authorization_code: (String code, String? redirect_uri) -> tokens
      def refresh: (String refresh_token) -> tokens
      def client_credentials: (String scope) -> tokens
    end
  end
end
