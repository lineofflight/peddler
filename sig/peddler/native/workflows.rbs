module Peddler
  class FeedDocumentUpload
    @document_id: String
    @response: Response
    attr_reader document_id: String
    attr_reader response: Response
    def initialize: (String document_id, Response response) -> void
    def inspect: () -> String
  end

  module Native
    WAIT_OPERATIONS: Hash[String, String]

    module Uploads
      CHUNK_BYTES: Integer
      def self.valid?: (untyped source, untyped content_length) -> bool
      def self.drain: (UploadHandle upload, String | (_DocumentIO & Object) source) -> void
    end

    class Engine
      def download_workflow_document: (String kind, String id, String config) -> DocumentHandle
      def wait_for: (String kind, String id, Float interval, Float timeout) -> response_parts
      def start_feed_document_upload: (String content_type, String config, Integer? content_length) -> UploadHandle
    end

    class UploadHandle
      def document_id: () -> String?
    end

    def self.valid_identifier?: (untyped value) -> bool
  end

  class Client
    def download_report_document: [T] (String document_id, **untyped transfer_options) { (Document document) -> T } -> T
                                | (String document_id, **untyped transfer_options) -> Document
    def download_feed_document: [T] (String document_id, **untyped transfer_options) { (Document document) -> T } -> T
                              | (String document_id, **untyped transfer_options) -> Document
    def download_query_document: [T] (String document_id, **untyped transfer_options) { (Document document) -> T } -> T
                               | (String document_id, **untyped transfer_options) -> Document
    def wait_for_report: (String report_id, ?interval: Integer | Float, ?timeout: Integer | Float) -> Response
    def wait_for_feed: (String feed_id, ?interval: Integer | Float, ?timeout: Integer | Float) -> Response
    def wait_for_query: (String query_id, ?interval: Integer | Float, ?timeout: Integer | Float) -> Response
    def create_and_upload_feed_document: (String | (_DocumentIO & Object) source, content_type: String, ?content_length: Integer?, **untyped transfer_options) -> FeedDocumentUpload

    private

    def workflow_download: [T] (String kind, String document_id, Hash[Symbol, untyped] transfer_options) ?{ (Document document) -> T } -> (T | Document)
    def workflow_wait: (String kind, String id, untyped interval, untyped timeout) -> Response
  end
end
