module Peddler
  class Continuation
    @operation: String?
    @keep: Array[String]?
    @drop: Array[String]
    @set: Hash[String, untyped]
    attr_reader operation: String?
    attr_reader keep: Array[String]?
    attr_reader drop: Array[String]
    attr_reader set: Hash[String, untyped]
    def initialize: (?operation: String?, ?keep: Array[String | Symbol]?, ?drop: Array[String | Symbol], ?set: Hash[String | Symbol, untyped]) -> void
  end

  class Pagination
    NONE: Object
    @operation: String
    @input: String
    @output: String
    @continuation: Continuation
    @input_keys: Array[String]
    @output_keys: Array[String]
    attr_reader operation: String
    attr_reader input: String
    attr_reader output: String
    attr_reader continuation: Continuation
    def initialize: (operation: String, input: String, output: String, ?continuation: Continuation) -> void
    def pages: (Native::Engine engine, Hash[String | Symbol, untyped] arguments) -> Enumerator[Response, void]

    private

    def segments: (String pointer) -> Array[String]
    def normalize: (untyped arguments) -> Hash[String, untyped]
    def generate: (Hash[String, untyped] arguments) -> String
    def token_in: (Hash[String, untyped] arguments) -> String?
    def follow: (Hash[String, untyped] initial, String token) -> Hash[String, untyped]
    def assign: (untyped node, Array[String] keys, untyped value) -> Hash[untyped, untyped]
    def next_token: (Response response, Array[String] seen) -> [String?, Symbol?]
  end
end
