module Peddler
  module Native
    module Arguments
      INTEGER: Regexp
      DECIMAL: Regexp
      NOT_JSON: Object
      JSON_RULE: String

      def self.string: (String name, untyped value, ?required: bool) -> String?
      def self.segment: (String name, untyped value, ?last: bool) -> String
      def self.array: (String name, untyped value, ?required: bool) -> Array[String]?
      def self.integer: (String name, untyped value, ?required: bool) -> Integer?
      def self.number: (String name, untyped value, ?required: bool) -> (Integer | Float)?
      def self.boolean: (String name, untyped value, ?required: bool) -> bool?
      def self.body: (String name, untyped value, ?required: bool) -> untyped
      def self.missing: (String name, bool required) -> nil
      def self.parameter: (String name, untyped value) -> String
      def self.rate_limit: (untyped value) -> Float?
      def self.encode: (Hash[Symbol, untyped] arguments, ?String? body) -> String
      def self.scalar: (String name, untyped value) -> String
      def self.plain: (untyped value) -> untyped
      def self.text: (String name, untyped value) -> String?
      def self.numeral?: (untyped value, Regexp pattern) -> bool
    end
  end
end
