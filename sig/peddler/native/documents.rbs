module Peddler
  class DocumentError < StandardError
  end

  class DocumentTimeoutError < DocumentError
  end

  class Document
    @handle: Native::DocumentHandle
    def initialize: (Native::DocumentHandle handle) -> void
    def status: () -> Integer
    def headers: () -> Array[[String, String]]
    def error_body: () -> String?
    def error_body_truncated?: () -> bool
    def close: () -> void
    def closed?: () -> bool
    def inspect: () -> String
    def each_chunk: () { (String chunk) -> void } -> Document
                  | () -> Enumerator[String, Document]
    def each_jsonl: () { (untyped row) -> void } -> Document
                  | () -> Enumerator[untyped, Document]
    def each_tsv: (?consistent_fields: bool) { (Array[String] row) -> void } -> Document
                | (?consistent_fields: bool) -> Enumerator[Array[String], Document]
    def json: (max_bytes: Integer) -> untyped
  end

  module Native
    UINT64_MAX: Integer
    def self.valid_utf8_string?: (untyped value) -> bool

    type document_parts = [Integer, Array[[String, String]], String, error_metadata?, bool]

    module TransferConfig
      def self.json: (Hash[Symbol, untyped] options) -> String
    end

    class Engine
      def download_document: (String url, String config) -> DocumentHandle
      def start_document_upload: (String url, String config, String content_type, Array[[String, String]] headers, Integer? content_length) -> UploadHandle
    end

    class DocumentHandle
      def status: () -> Integer
      def headers: () -> Array[[String, String]]
      def error_body: () -> String?
      def error_body_truncated?: () -> bool
      def close: () -> void
      def closed?: () -> bool
      def next_row: (String mode, bool consistent_fields) -> untyped
      def json: (Integer max_bytes) -> String
    end

    class UploadHandle
      def completed?: () -> bool
      def push: (String chunk) -> bool
      def finish: () -> document_parts
      def close: () -> void
    end

    module DocumentDecimal
      def self.try_convert: (String text) -> BigDecimal
    end
  end

  interface _DocumentIO
    def read: (Integer length) -> String?
  end

  class Client
    def download_document: [T] (String url, **untyped transfer_options) { (Document document) -> T } -> T
                         | (String url, **untyped transfer_options) -> Document
    def upload_document: (String url, String | (_DocumentIO & Object) source, content_type: String, ?headers: Hash[String, String], ?content_length: Integer?, **untyped transfer_options) -> Response
  end
end
