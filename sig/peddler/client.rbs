module Peddler
  class Client
    @engine: Native::Engine
    @endpoint: Endpoint?
    @sandbox: bool
    @sandbox_view: Client?

    def initialize: (access_token: String | Native::_TokenSource, ?region: String?, ?base_url: String?, ?timeout: Numeric, ?retries: Integer) -> void
    def with_access_token: (String | Native::_TokenSource access_token) -> Client
    def sandbox: () -> Client
    def sandbox?: () -> bool
    def request: (String method, String path, ?params: Hash[String | Symbol, String | Integer | Float | bool], ?body: String | Hash[untyped, untyped] | Array[untyped] | nil) -> Response

    private

    def view: (Native::Engine engine, ?sandbox: bool) -> Client
  end
end
