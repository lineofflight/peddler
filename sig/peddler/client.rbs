module Peddler
  class Client
    @engine: Native::Engine
    @endpoint: Endpoint?
    @sandbox: bool
    @sandbox_view: Client?

    def initialize: (access_token: String | Native::_TokenSource, ?region: String?, ?base_url: String?, ?sandbox: boolish, ?timeout: Numeric, ?retries: Integer, ?retry_delay: Numeric, ?max_retry_delay: Numeric) -> void
    def with_access_token: (String | Native::_TokenSource access_token) -> Client
    def sandbox: () -> Client
    def sandbox?: () -> bool
    def pages: (Pagination pagination, Hash[String | Symbol, untyped] arguments, ?max_pages: Integer?) -> Enumerator[Response, void]
    def request: (String method, String path, ?params: Hash[String | Symbol, String | Integer | Float | bool], ?body: String | Hash[untyped, untyped] | Array[untyped] | nil, ?operation: String) -> Response

    private

    def view: (Native::Engine engine, ?sandbox: bool) -> Client
  end
end
