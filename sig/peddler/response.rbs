module Peddler
  class Response
    @json: untyped
    @metadata: Native::error_metadata?
    @operation: String?
    @body_truncated: bool

    attr_reader status: Integer
    attr_reader headers: Array[[String, String]]
    attr_reader body: String

    def self.from_parts: (Native::response_parts parts, ?String? operation) -> Response
    def self.from_document_parts: (Native::document_parts parts) -> Response
    def initialize: (Integer status, Array[[String, String]] headers, String body, ?Native::error_metadata? metadata, ?operation: String?, ?body_truncated: bool) -> void
    def raise_for_status!: () -> self
    def body_truncated?: () -> bool
    def json: () -> untyped
    def to_h: () -> untyped
    def dig: (*untyped keys) -> untyped
    def parse: () -> untyped

    private

    def parser: () -> untyped
  end
end
