module Peddler
  class Response
    class Status < SimpleDelegator
      def initialize: (Integer code) -> void

      # What the Integer it wraps answers, as v5's status did
      def <: (Integer | Float other) -> bool
      def <=: (Integer | Float other) -> bool
      def >: (Integer | Float other) -> bool
      def >=: (Integer | Float other) -> bool
      def <=>: (untyped other) -> Integer?
      def ==: (untyped other) -> bool
      def between?: (Integer | Float min, Integer | Float max) -> bool
      def to_i: () -> Integer
      def to_s: () -> String
    end
  end
end
