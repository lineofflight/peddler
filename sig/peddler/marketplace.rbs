module Peddler
  class Marketplace < Data
    def self.new: (id: String, country_code: String, country_name: String, selling_region: String) -> Marketplace

    # A finder for each country code, and `gb` for the United Kingdom
    def self.ae: () -> Marketplace
    def self.au: () -> Marketplace
    def self.be: () -> Marketplace
    def self.br: () -> Marketplace
    def self.ca: () -> Marketplace
    def self.de: () -> Marketplace
    def self.eg: () -> Marketplace
    def self.es: () -> Marketplace
    def self.fr: () -> Marketplace
    def self.gb: () -> Marketplace
    def self.ie: () -> Marketplace
    def self.in: () -> Marketplace
    def self.it: () -> Marketplace
    def self.jp: () -> Marketplace
    def self.mx: () -> Marketplace
    def self.nl: () -> Marketplace
    def self.pl: () -> Marketplace
    def self.sa: () -> Marketplace
    def self.se: () -> Marketplace
    def self.sg: () -> Marketplace
    def self.tr: () -> Marketplace
    def self.uk: () -> Marketplace
    def self.us: () -> Marketplace
    def self.za: () -> Marketplace

    attr_reader country_code: String
    attr_reader country_name: String
    attr_reader id: String
    attr_reader selling_region: String
  end
end
