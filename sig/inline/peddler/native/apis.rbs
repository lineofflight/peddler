      # - included_data: A comma-delimited list of datasets to include in the response.
      # - rate_limit: Requests per second
      def get_selection: (String promotion_id, String selection_id, Integer revision_id, ?locale: String?, ?pagination_token: String?, ?limit: Integer?, ?included_data: Array[String]?, ?rate_limit: (Float | Integer)?) -> Response

      # Each page of {#get_selection}
