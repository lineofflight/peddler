      # - rate_limit: Requests per second
      def get_definitions_product_type: (String product_type, Array[String] marketplace_ids, ?seller_id: String?, ?product_type_version: String?, ?requirements: String?, ?requirements_enforced: String?, ?locale: String?, ?parentage_level: String?, ?rate_limit: (Float | Integer)?) -> Response

