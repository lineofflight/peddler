# frozen_string_literal: true

# Checks lib against the signatures as an application gets them: no inline reading, sig/inline included.
target :shipped do
  signature "sig"
  check "lib"
  ignore "lib/generator.rb", "lib/generator"
  # It is written against WebMock, which has no signatures.
  ignore "lib/peddler/webmock.rb"
  library("delegate", "json", "socket", "time", "uri")
end
